# Copy to `.env` and fill in. Loaded by main.py and kapruka_concierge/agent.py
# via python-dotenv.

# Google AI Studio key — used by the Gemini agents (and the try-on image model).
GOOGLE_API_KEY=your-google-ai-studio-key

# Optional: override the virtual try-on image model (Feature 3).
# TRYON_MODEL=gemini-2.5-flash-image

# Optional: virtual try-on image backend — "gemini" (default) or "grok".
# Grok (xAI) does identity-preserving image editing too; we wire SINGLE-item
# try-on for it (1 garment + the user photo). To A/B test it, set:
# TRYON_PROVIDER=grok
# XAI_API_KEY=your-xai-api-key
# GROK_TRYON_MODEL=grok-imagine-image-quality

# Optional: restrict product results to wearables only — Clothing (garments) +
# Fashion (shoes, bags, belts, eyewear); default on. Kapruka is a broad gift
# marketplace, so keyword searches otherwise leak in books, gift sets, cakes,
# jewellery, etc. Set to false to show all categories again.
# RESTRICT_TO_CLOTHING=true

# --- Voice (Phase 1) -------------------------------------------------------
# Gemini Live model for the realtime English + Tamil voice path (/live).
# LIVE_MODEL=gemini-2.0-flash-live-001

# Azure Speech — used ONLY for the Sinhala voice path (Gemini Live can't do
# Sinhala; Google Cloud has no Sinhala TTS voice). Get these from an Azure
# "Speech service" resource. Without them, Sinhala voice is disabled but the
# English/Tamil Live path and text chat still work.
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=southeastasia
# AZURE_TTS_VOICE=si-LK-ThiliniNeural   # or si-LK-SameeraNeural (male)
# AZURE_STT_LANG=si-LK
